<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Add Topping — Papa's Pizzeria</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
  <style>
    :root {
      --red: #c0392b;
      --red-dark: #962d22;
      --cream: #fdf6ec;
      --warm-white: #fffaf4;
      --charcoal: #1a1a1a;
      --muted: #7a6a5a;
      --border: #e8d9c5;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--warm-white);
      color: var(--charcoal);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* ── NAVBAR ── */
    nav {
      background: var(--charcoal);
      position: sticky;
      top: 0;
      z-index: 100;
      box-shadow: 0 2px 20px rgba(0,0,0,0.3);
    }

    .nav-inner {
      max-width: 1100px;
      margin: 0 auto;
      padding: 0 2rem;
      height: 64px;
      display: flex;
      align-items: center;
      gap: 2rem;
    }

    .nav-brand {
      font-family: 'Playfair Display', serif;
      font-size: 1.5rem;
      font-weight: 900;
      color: var(--cream);
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      letter-spacing: -0.02em;
    }

    .nav-links {
      display: flex;
      list-style: none;
      gap: 0.25rem;
      flex: 1;
    }

    .nav-links a {
      color: #bbb;
      text-decoration: none;
      font-size: 0.9rem;
      padding: 0.4rem 0.9rem;
      border-radius: 6px;
      transition: color 0.2s, background 0.2s;
    }

    .nav-links a:hover,
    .nav-links a.active {
      color: var(--cream);
      background: rgba(255,255,255,0.08);
    }

    .nav-search {
      display: flex;
      gap: 0.5rem;
      margin-left: auto;
    }

    .nav-search input {
      background: rgba(255,255,255,0.08);
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 8px;
      padding: 0.45rem 1rem;
      color: var(--cream);
      font-family: 'DM Sans', sans-serif;
      font-size: 0.85rem;
      width: 200px;
      outline: none;
      transition: border-color 0.2s;
    }

    .nav-search input::placeholder { color: #888; }
    .nav-search input:focus { border-color: var(--red); }

    .nav-search button {
      background: var(--red);
      color: white;
      border: none;
      border-radius: 8px;
      padding: 0.45rem 1rem;
      font-family: 'DM Sans', sans-serif;
      font-size: 0.85rem;
      font-weight: 500;
      cursor: pointer;
      transition: background 0.2s;
    }

    .nav-search button:hover { background: var(--red-dark); }

    /* ── PAGE HEADER ── */
    .page-header {
      background: var(--charcoal);
      padding: 3rem 2rem 2.5rem;
      border-bottom: 1px solid rgba(255,255,255,0.06);
    }

    .page-header-inner {
      max-width: 1100px;
      margin: 0 auto;
    }

    .breadcrumb {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.82rem;
      color: #777;
      margin-bottom: 1rem;
    }

    .breadcrumb a {
      color: #999;
      text-decoration: none;
      transition: color 0.15s;
    }

    .breadcrumb a:hover { color: var(--cream); }
    .breadcrumb span { color: #555; }

    .page-header h1 {
      font-family: 'Playfair Display', serif;
      font-size: clamp(2rem, 4vw, 2.8rem);
      font-weight: 900;
      color: var(--cream);
      letter-spacing: -0.03em;
      line-height: 1.1;
    }

    .page-header h1 span { color: var(--red); }
    .page-header p { color: #999; font-size: 0.9rem; margin-top: 0.4rem; font-weight: 300; }

    /* ── MAIN ── */
    .container {
      max-width: 1100px;
      margin: 0 auto;
      padding: 2.5rem 2rem;
      flex: 1;
      display: flex;
      gap: 2.5rem;
      align-items: flex-start;
    }

    /* ── FORM CARD ── */
    .form-card {
      background: white;
      border: 1.5px solid var(--border);
      border-radius: 18px;
      padding: 2rem;
      flex: 1;
      max-width: 540px;
    }

    .form-group {
      margin-bottom: 1.4rem;
    }

    .form-group label {
      display: block;
      font-size: 0.8rem;
      font-weight: 500;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin-bottom: 0.5rem;
    }

    .form-group input,
    .form-group select {
      width: 100%;
      padding: 0.75rem 1rem;
      border: 1.5px solid var(--border);
      border-radius: 10px;
      font-family: 'DM Sans', sans-serif;
      font-size: 0.95rem;
      color: var(--charcoal);
      background: white;
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
    }

    .form-group input:focus,
    .form-group select:focus {
      border-color: var(--red);
      box-shadow: 0 0 0 3px rgba(192, 57, 43, 0.08);
    }

    .form-group input::placeholder { color: #bbb; }

    .form-hint {
      font-size: 0.78rem;
      color: #bbb;
      margin-top: 0.35rem;
    }

    /* ── FORM ACTIONS ── */
    .form-actions {
      display: flex;
      gap: 0.75rem;
      margin-top: 2rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--border);
    }

    .btn-primary {
      flex: 2;
      padding: 0.85rem;
      border-radius: 10px;
      border: none;
      background: var(--red);
      font-family: 'DM Sans', sans-serif;
      font-size: 0.95rem;
      font-weight: 500;
      color: white;
      cursor: pointer;
      transition: background 0.2s, transform 0.15s;
    }

    .btn-primary:hover { background: var(--red-dark); transform: translateY(-1px); }

    .btn-cancel {
      flex: 1;
      padding: 0.85rem;
      border-radius: 10px;
      border: 1.5px solid var(--border);
      background: white;
      font-family: 'DM Sans', sans-serif;
      font-size: 0.95rem;
      font-weight: 500;
      color: var(--muted);
      cursor: pointer;
      text-decoration: none;
      text-align: center;
      transition: border-color 0.15s, color 0.15s;
    }

    .btn-cancel:hover { border-color: #aaa; color: var(--charcoal); }

    /* ── FLASH ── */
    .flash {
      padding: 0.85rem 1.25rem;
      border-radius: 10px;
      margin-bottom: 1.5rem;
      font-size: 0.9rem;
      font-weight: 500;
    }

    .flash.error { background: #fff5f5; color: var(--red); border: 1px solid #f5c6c6; }

    /* ── SIDE INFO ── */
    .side-info {
      width: 260px;
      flex-shrink: 0;
    }

    .info-card {
      background: white;
      border: 1.5px solid var(--border);
      border-radius: 16px;
      padding: 1.4rem;
      margin-bottom: 1rem;
    }

    .info-card h3 {
      font-family: 'Playfair Display', serif;
      font-size: 0.95rem;
      font-weight: 700;
      margin-bottom: 0.9rem;
      color: var(--charcoal);
    }

    .category-list {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .category-item {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      font-size: 0.85rem;
      color: var(--muted);
    }

    .category-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      flex-shrink: 0;
    }

    /* ── FOOTER ── */
    footer {
      background: var(--charcoal);
      color: #777;
      text-align: center;
      padding: 1.2rem 2rem;
      font-size: 0.82rem;
    }

    @media (max-width: 700px) {
      .nav-search { display: none; }
      .container { flex-direction: column; }
      .side-info { width: 100%; }
    }
  </style>
</head>
<body>

  <%# ─── NAVBAR ─── %>
  <nav>
    <div class="nav-inner">
      <a class="nav-brand" href="/">🍕 Papa's Pizzeria</a>
      <ul class="nav-links">
        <li><a href="/">Home</a></li>
        <li><a href="/toppings" class="active">Toppings</a></li>
        <li><a href="/categories">Categories</a></li>
      </ul>
      <form class="nav-search" role="search" action="/menu/search" method="GET">
        <input type="search" placeholder="Search the menu..." name="search">
        <button type="submit">Search</button>
      </form>
    </div>
  </nav>

  <%# ─── PAGE HEADER ─── %>
  <div class="page-header">
    <div class="page-header-inner">
      <div class="breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/toppings">Toppings</a>
        <span>/</span>
        New
      </div>
      <h1>Add a <span>Topping</span></h1>
      <p>Give it a name and assign it to a category</p>
    </div>
  </div>

  <%# ─── MAIN ─── %>
  <div class="container">

    <%# ─── FORM ─── %>
    <div class="form-card">

      <% if (locals.flash) { %>
        <div class="flash <%= flash.type %>"><%= flash.message %></div>
      <% } %>

      <%#
        POST to /toppings
        Controller calls insertTopping(name, categoryId)

        Expected data from Express:
        toppingCategories — from getAllToppingCategories()
          [ { id, name }, ... ]
      %>
      <form action="/toppings" method="POST">

        <div class="form-group">
          <label for="name">Topping Name</label>
          <input
            type="text"
            id="name"
            name="name"
            placeholder="e.g. Jalapeño"
            required
            value="<%= locals.formData ? formData.name : '' %>"
          >
          <p class="form-hint">Must be unique within the selected category.</p>
        </div>

        <div class="form-group">
          <label for="category_id">Category</label>
          <select id="category_id" name="category_id" required>
            <option value="" disabled selected>Select a category...</option>
            <% toppingCategories.forEach(function(cat) { %>
              <option
                value="<%= cat.id %>"
                <%= locals.formData && formData.category_id == cat.id ? 'selected' : '' %>
              >
                <%= cat.name %>
              </option>
            <% }); %>
          </select>
        </div>

        <div class="form-actions">
          <a href="/toppings" class="btn-cancel">Cancel</a>
          <button type="submit" class="btn-primary">Add Topping</button>
        </div>

      </form>
    </div>

    <%# ─── SIDE INFO ─── %>
    <div class="side-info">
      <div class="info-card">
        <h3>Available Categories</h3>
        <div class="category-list">
          <% toppingCategories.forEach(function(cat) { %>
            <div class="category-item">
              <div class="category-dot" style="background: var(--red); opacity: 0.6;"></div>
              <%= cat.name %>
            </div>
          <% }); %>
        </div>
      </div>
    </div>

  </div>

  <footer>© 2026 Papa's Pizzeria. All rights reserved.</footer>

</body>
</html>
